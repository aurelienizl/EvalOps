# Copy to .env and replace these values before startup.
POSTGRES_PASSWORD=replace-with-a-long-database-owner-password
BACKEND_DB_PASSWORD=replace-with-a-different-backend-password
MANAGER_DB_PASSWORD=replace-with-a-different-manager-password
# Set true when the proxy serves HTTPS.
COOKIE_SECURE=false
SSH_HOST=localhost
SSH_BIND_ADDRESS=0.0.0.0
DATA_ROOT=/var/lib/evalops
DEPLOYMENT_ID=evalops
