# Configuration globale EvalOps
PLATFORM_INSTANCE=evalops-prod
COURSES_PATH=/courses
PUBLIC_ORIGIN=http://localhost

# Configuration SSH pour les conteneurs étudiants
SSH_HOST=localhost
SSH_BIND_ADDRESS=0.0.0.0
SSH_PORT_MIN=22000
SSH_PORT_MAX=22999

# Base de données SQLite
DATABASE_PATH=/data/app.db

# URL du Container Manager depuis le Backend
CONTAINER_MANAGER_URL=http://container_manager:8001
CONTAINER_MANAGER_START_PERIOD=30m
